{
  "name": "sounddraft",
  "version": "0.1.0",
  "description": "A local writing studio for spoken drafts",
  "author": "SoundDraft",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "vite build && electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "vite build && node scripts/smoke.cjs",
    "build:audio": "node scripts/build-audio.cjs",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "dist:dir": "vite build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "docx": "^9.5.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.6",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.sounddraft.desktop",
    "productName": "SoundDraft",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/${arch}",
        "to": "audio-tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "SoundDraft records your dictation locally when you choose Record."
      }
    },
    "artifactName": "SoundDraft-${version}-${arch}.${ext}"
  }
}
